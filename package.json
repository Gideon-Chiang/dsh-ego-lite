{
    "name": "dsh-ego-lite",
    "version": "0.1.14",
    "description": "Drive the installed ego lite app from DeepSeek Harness: 20 structured ego_app_* tools over the official ego-browser CLI, running inside real ego TaskSpaces.",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "README.en.md",
        "LICENSE",
        "CHANGELOG.md",
        "docs"
    ],
    "scripts": {
        "test": "node --test \"test/**/*.test.mjs\"",
        "test:live": "node test/live-e2e.mjs && node test/pointer-selector.mjs"
    },
    "keywords": [
        "dsh-plugin",
        "deepseek-harness",
        "dsh",
        "ego-lite",
        "ego-browser",
        "browser-automation",
        "cordis"
    ],
    "license": "MIT",
    "author": "Gideon Chiang",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gideon-Chiang/dsh-ego-lite.git"
    },
    "homepage": "https://github.com/Gideon-Chiang/dsh-ego-lite#readme",
    "bugs": {
        "url": "https://github.com/Gideon-Chiang/dsh-ego-lite/issues"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "engines": {
        "node": ">=20"
    },
    "os": [
        "win32",
        "darwin",
        "linux"
    ],
    "dependencies": {
        "@deepseek-ai/schemastery": "^3.18.5"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-tools": "*"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-tools": {
            "optional": true
        }
    },
    "devDependencies": {
        "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
